---
import MainLayout from "../layouts/MainLayout.astro";

// SEO Estratégico Multicanal para el mercado de Bogotá
const title = "Contacto y Pedidos | Amasar Bogotá";
const description =
  "Solicita galletas artesanales, café y detalles para eventos. Atendemos panaderías, empresas y familias en Bogotá con entrega garantizada.";
---

<MainLayout title={title} description={description}>
  <section class="bg-background min-h-screen py-24 relative overflow-hidden">
    <div
      class="absolute top-0 left-0 w-96 h-96 bg-primary/5 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"
    >
    </div>

    <div
      class="max-w-6xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center relative z-10"
    >
      <div>
        <span
          class="inline-block py-1 px-4 rounded-full bg-primary/10 text-primary font-bold text-[10px] uppercase tracking-[0.2em] mb-6"
        >
          Atención Personalizada
        </span>
        <h1
          class="text-6xl md:text-7xl font-serif text-secondary mb-8 leading-tight"
        >
          Calidad artesanal para <span class="text-primary italic"
            >momentos</span
          > únicos.
        </h1>
        <p class="text-lg text-slate-600 mb-10 leading-relaxed">
          Desde el abastecimiento recurrente para tu **panadería**, el catering
          de tu **empresa**, hasta el detalle especial para tu **hogar**. En
          Amasar Bogotá, horneamos soluciones a tu medida.
        </p>

        <div class="space-y-8">
          <div class="flex items-center gap-5 group">
            <div
              class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center shadow-sm group-hover:bg-primary/10 transition-colors"
            >
              🚚
            </div>
            <div>
              <p
                class="text-sm font-black text-secondary uppercase tracking-widest"
              >
                Cobertura Total
              </p>
              <p class="text-xs text-slate-400">
                Despachos diarios en toda Bogotá.
              </p>
            </div>
          </div>
          <div class="flex items-center gap-5 group">
            <div
              class="w-14 h-14 bg-white rounded-2xl flex items-center justify-center shadow-sm group-hover:bg-primary/10 transition-colors"
            >
              ✨
            </div>
            <div>
              <p
                class="text-sm font-black text-secondary uppercase tracking-widest"
              >
                Personalización
              </p>
              <p class="text-xs text-slate-400">
                Galletas impresas con tu logo o temática.
              </p>
            </div>
          </div>
        </div>
      </div>

      <div
        class="bg-white p-10 md:p-14 rounded-[3.5rem] shadow-2xl border border-primary/5"
      >
        <form id="contactForm" class="space-y-6">
          <div class="grid grid-cols-1 gap-6">
            <div>
              <label
                class="block text-[10px] uppercase font-black tracking-widest text-slate-400 mb-2"
                >¿Cómo te categorizas?</label
              >
              <select
                name="tipo_cliente"
                required
                class="w-full p-4 rounded-2xl bg-background border-none focus:ring-2 focus:ring-primary outline-none transition-all font-bold text-secondary text-sm"
              >
                <option value="Panaderia">Panadería / Pastelería</option>
                <option value="Empresa">Empresa / Evento Corporativo</option>
                <option value="Particular">Particular (Fiesta o Familiar)</option>
              </select>
            </div>

            <div>
              <label
                class="block text-[10px] uppercase font-black tracking-widest text-slate-400 mb-2"
                >Nombre de la Entidad o Evento</label
              >
              <input
                type="text"
                name="panaderia"
                placeholder="Ej: Masa Madre, Cumpleaños de Luciana..."
                required
                class="w-full p-4 rounded-2xl bg-background border-none focus:ring-2 focus:ring-primary outline-none transition-all text-sm"
              />
            </div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
            <div>
              <label
                class="block text-[10px] uppercase font-black tracking-widest text-slate-400 mb-2"
                >Tu Nombre</label
              >
              <input
                type="text"
                name="nombre"
                required
                class="w-full p-4 rounded-2xl bg-background border-none focus:ring-2 focus:ring-primary outline-none transition-all text-sm"
              />
            </div>
            <div>
              <label
                class="block text-[10px] uppercase font-black tracking-widest text-slate-400 mb-2"
                >WhatsApp</label
              >
              <input
                type="tel"
                name="whatsapp"
                required
                placeholder="3XX XXX XXXX"
                class="w-full p-4 rounded-2xl bg-background border-none focus:ring-2 focus:ring-primary outline-none transition-all text-sm"
              />
            </div>
          </div>

          <div>
            <label
              class="block text-[10px] uppercase font-black tracking-widest text-slate-400 mb-2"
              >Tu Email</label
            >
            <input
              type="email"
              name="email"
              required
              placeholder="ejemplo@correo.com"
              class="w-full p-4 rounded-2xl bg-background border-none focus:ring-2 focus:ring-primary outline-none transition-all text-sm"
            />
          </div>

          <div>
            <label
              class="block text-[10px] uppercase font-black tracking-widest text-slate-400 mb-2"
              >Producto de interés</label
            >
            <select
              name="interes"
              class="w-full p-4 rounded-2xl bg-background border-none focus:ring-2 focus:ring-primary outline-none transition-all font-bold text-secondary text-sm"
            >
              <option value="Galletas">Galletas Decoradas</option>
              <option value="Cafe">Café de Origen</option>
              <option value="Chocolateria">Chocolatería</option>
              <option value="Varios">Varios / Mix</option>
            </select>
          </div>

          <div>
            <label
              class="block text-[10px] uppercase font-black tracking-widest text-slate-400 mb-2"
              >Detalles del pedido</label
            >
            <textarea
              name="mensaje"
              rows="3"
              placeholder="Cuéntanos cantidades o fecha del evento..."
              class="w-full p-4 rounded-2xl bg-background border-none focus:ring-2 focus:ring-primary outline-none transition-all text-sm"
            ></textarea>
          </div>

          <button
            id="submitBtn"
            type="submit"
            class="w-full py-5 bg-secondary text-white rounded-2xl font-black uppercase tracking-[0.2em] text-xs hover:bg-primary transition-all shadow-xl shadow-primary/20 active:scale-95 disabled:opacity-50 disabled:cursor-not-allowed"
          >
            <span id="btnText">Enviar Solicitud</span>
          </button>
        </form>

        <div
          id="successMessage"
          class="hidden text-center py-12 animate-fade-in"
        >
          <div
            class="w-20 h-20 bg-green-50 text-green-500 rounded-full flex items-center justify-center text-4xl mx-auto mb-6"
          >
            ✓
          </div>
          <h3 class="text-3xl font-serif text-secondary mb-3">
            ¡Mensaje enviado con éxito!
          </h3>
          <p class="text-slate-500 mb-10 leading-relaxed">
            Hemos recibido tu información. Un maestro artesano de Amasar te
            escribirá pronto.
          </p>
          <button
            id="btnReset"
            class="text-primary font-black text-[10px] uppercase tracking-[0.2em] border-b-2 border-primary pb-1 hover:text-secondary hover:border-secondary transition-all"
          >
            Enviar otro mensaje
          </button>
        </div>
      </div>
    </div>
  </section>
</MainLayout>

<script>
  function setupForm() {
    const form = document.getElementById("contactForm") as HTMLFormElement;
    const successMessage = document.getElementById("successMessage");
    const btnReset = document.getElementById("btnReset");
    const submitBtn = document.getElementById("submitBtn") as HTMLButtonElement;
    const btnText = document.getElementById("btnText");

    if (!form || !successMessage || !submitBtn || !btnText) return;

    form.addEventListener("submit", async (e) => {
      e.preventDefault();

      // Bloqueamos el botón para evitar doble envío
      submitBtn.disabled = true;
      btnText.innerText = "Enviando...";

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      try {
        const response = await fetch("/api/contact", {
          method: "POST",
          headers: {
            "Content-Type": "application/json",
          },
          body: JSON.stringify(data),
        });

        if (response.ok) {
          form.classList.add("hidden");
          successMessage.classList.remove("hidden");
          form.reset();
        } else {
          const result = await response.json();
          console.error("Error API:", result);
          alert("Error al enviar: " + (result.message || "Intenta de nuevo."));
        }
      } catch (error) {
        console.error("Error Network:", error);
        alert("Hubo un problema de conexión. Por favor, intenta de nuevo.");
      } finally {
        // Restauramos el botón
        submitBtn.disabled = false;
        btnText.innerText = "Enviar Solicitud";
      }
    });

    btnReset?.addEventListener("click", () => {
      successMessage.classList.add("hidden");
      form.classList.remove("hidden");
    });
  }

  document.addEventListener("astro:page-load", setupForm);
</script>

<style>
  @keyframes fade-in {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }
  .animate-fade-in {
    animation: fade-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
</style>
