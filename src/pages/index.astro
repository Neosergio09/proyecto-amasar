---
import MainLayout from "../layouts/MainLayout.astro";
import { supabase, getOptimizedImage } from "../lib/supabase";
import { Image } from "astro:assets";
import heroImage from "../assets/unnamed.jpg";

// SEO y Copywriting Estratégico
const title =
  "Amasar | Galletas Artesanales, Café y Detalles para Momentos Únicos";
const description =
  "El sabor artesanal de Bogotá en tu mesa. Galletas decoradas, café premium y jugos naturales para panaderías, eventos corporativos y celebraciones especiales.";

const { data: destacados } = await supabase
  .from("productos")
  .select("id, nombre, descripcion, imagen_url, categoria")
  .limit(9);
---

<MainLayout title={title} description={description}>
  <link
    rel="preconnect"
    href="https://fonts.googleapis.com"
    crossorigin
    slot="head"
  />
  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
    slot="head"
  />

  <section
    class="relative min-h-[90vh] flex items-center pt-20 overflow-hidden bg-background"
    aria-label="Introducción"
  >
    <div class="max-w-7xl mx-auto px-6 grid md:grid-cols-2 gap-16 items-center">
      <div class="z-10">
        <div
          class="inline-block py-1 px-4 rounded-full bg-primary/10 mb-6 border border-primary/20"
        >
          <span
            class="text-orange-950 font-black text-[10px] uppercase tracking-[0.2em]"
          >
            ARTESANÍA LOCAL • BOGOTÁ, CO
          </span>
        </div>

        <h1
          class="text-6xl md:text-7xl font-serif leading-[1.1] mb-8 text-secondary"
        >
          El sabor que <span class="italic text-primary">transforma</span> cada reunión.
        </h1>
        <p class="text-xl text-slate-800 mb-10 max-w-lg leading-relaxed">
          Desde el detalle perfecto para un **cumpleaños**, el refrigerio de tu
          **empresa**, hasta el stock de tu **panadería**. Galletas, café y
          jugos con entrega garantizada.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/productos"
            class="bg-secondary text-white px-10 py-5 rounded-2xl font-bold text-lg hover:bg-primary transition-all shadow-xl shadow-secondary/10"
            aria-label="Explorar nuestro catálogo de productos"
          >
            Explorar Catálogo
          </a>
          <a
            href="/contacto"
            class="bg-white border-2 border-slate-300 text-secondary px-10 py-5 rounded-2xl font-bold text-lg hover:border-primary transition-all"
          >
            Cotizar Evento
          </a>
        </div>

        <div
          class="mt-12 pt-8 border-t border-slate-200 flex gap-8 opacity-100"
        >
          <p
            class="text-[10px] font-black uppercase tracking-tighter text-slate-950"
          >
            ✨ Panaderías
          </p>
          <p
            class="text-[10px] font-black uppercase tracking-tighter text-slate-950"
          >
            💼 Empresas
          </p>
          <p
            class="text-[10px] font-black uppercase tracking-tighter text-slate-950"
          >
            🎂 Eventos
          </p>
        </div>
      </div>

      <div class="relative">
        <div
          class="aspect-[4/5] rounded-[3rem] overflow-hidden shadow-2xl rotate-2 hover:rotate-0 transition-transform duration-700"
        >
          <Image
            src={heroImage}
            alt="Bodegón de galletas artesanales y café de origen Amasar en Bogotá"
            class="w-full h-full object-cover scale-110 hover:scale-100 transition-transform duration-1000"
            loading="eager"
            fetchpriority="high"
            format="avif"
            quality={80}
            width={800}
          />
        </div>
        <div
          class="absolute -bottom-10 -left-10 bg-primary p-10 rounded-full text-white shadow-2xl border-8 border-background animate-bounce-slow"
        >
          <p class="text-center font-bold">
            <span class="block text-4xl text-white">Bogotá</span>
            <span
              class="text-[10px] uppercase tracking-tighter font-black text-slate-950"
              >Envío Express</span
            >
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-24 bg-white" aria-labelledby="soluciones-title">
    <div class="max-w-7xl mx-auto px-6">
      <h2 id="soluciones-title" class="sr-only">
        Nuestras soluciones por tipo de cliente
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        <div
          class="p-12 rounded-[3rem] bg-slate-50 border border-slate-100 group hover:bg-primary transition-all duration-500"
        >
          <p class="text-4xl mb-6" aria-hidden="true">🏪</p>
          <h3
            class="text-2xl font-serif mb-4 group-hover:text-white text-secondary"
          >
            Para Negocios
          </h3>
          <p class="text-slate-700 group-hover:text-white/95">
            Suministro recurrente para panaderías y cafeterías que buscan
            calidad premium constante.
          </p>
        </div>
        <div
          class="p-12 rounded-[3rem] bg-slate-50 border border-slate-100 group hover:bg-secondary transition-all duration-500"
        >
          <p class="text-4xl mb-6" aria-hidden="true">🏢</p>
          <h3
            class="text-2xl font-serif mb-4 group-hover:text-white text-secondary"
          >
            Corporativo
          </h3>
          <p class="text-slate-700 group-hover:text-white/95">
            Refrigerios para reuniones, regalos empresariales y lanzamientos de
            marca en Bogotá.
          </p>
        </div>
        <div
          class="p-12 rounded-[3rem] bg-slate-50 border border-slate-100 group hover:bg-primary transition-all duration-500"
        >
          <p class="text-4xl mb-6" aria-hidden="true">🎁</p>
          <h3
            class="text-2xl font-serif mb-4 group-hover:text-white text-secondary"
          >
            Celebraciones
          </h3>
          <p class="text-slate-700 group-hover:text-white/95">
            Fiestas de cumpleaños, reuniones familiares y detalles
            personalizados para tu hogar.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="py-32 bg-background" aria-labelledby="catalogo-title">
    <div class="max-w-7xl mx-auto px-6">
      <div class="text-center mb-20">
        <h2
          id="catalogo-title"
          class="text-4xl md:text-5xl font-serif text-secondary mb-4"
        >
          Todo lo que necesitas para <span class="text-primary italic"
            >sorprender</span
          >
        </h2>
        <div class="h-1 w-20 bg-primary mx-auto"></div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-5 gap-8">
        {
          [
            {
              name: "Galletas",
              desc: "Decoradas y personalizadas.",
              icon: "🍪",
              href: "/productos/galletas",
            },
            {
              name: "Chocolatería",
              desc: "Detalles que enamoran.",
              icon: "🍫",
              href: "/productos/chocolateria",
            },
            {
              name: "Café",
              desc: "De origen para tu oficina.",
              icon: "☕",
              href: "/productos/cafe",
            },
            {
              name: "Jugos",
              desc: "100% naturales y frescos.",
              icon: "🥤",
              href: "/productos/jugos",
            },
            {
              name: "Gelatina",
              desc: "Postres coloridos y deliciosos.",
              icon: "🍮",
              href: "/productos/gelatina",
            },
          ].map((cat) => (
            <a
              href={cat.href}
              class="group p-10 rounded-[2.5rem] bg-white border border-slate-100 hover:border-primary transition-all hover:shadow-2xl text-center block"
            >
              <span
                class="text-5xl mb-6 block transform group-hover:scale-110 transition-transform"
                aria-hidden="true"
              >
                {cat.icon}
              </span>
              <h3 class="text-xl font-serif mb-2 group-hover:text-primary transition-colors text-secondary">
                {cat.name}
              </h3>
              <p class="text-slate-800 text-xs uppercase tracking-widest font-black">
                {cat.desc}
              </p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {
    destacados && destacados.length > 0 && (
      <section class="py-32 bg-white" aria-labelledby="favoritos-title">
        <div class="max-w-7xl mx-auto px-6">
          <div class="flex justify-between items-end mb-16">
            <h2
              id="favoritos-title"
              class="text-4xl font-serif text-secondary leading-tight"
            >
              Nuestros favoritos{" "}
              <>
                <br />
                <span class="text-primary italic">del mes</span>
              </>
            </h2>
            <a
              href="/productos"
              class="text-orange-950 font-black border-b-2 border-primary pb-1 uppercase text-[10px] tracking-widest hover:text-primary transition-colors"
            >
              Ver catálogo completo
            </a>
          </div>
          <div
            class="embla overflow-hidden w-full cursor-grab active:cursor-grabbing"
            id="favoritos-carousel"
          >
            <div class="embla__container flex -ml-6">
              {destacados.map((prod) => (
                <div class="embla__slide flex-[0_0_100%] md:flex-[0_0_50%] lg:flex-[0_0_33.333%] min-w-0 pl-6">
                  <article class="group h-full flex flex-col p-4 bg-white rounded-[3rem] border border-slate-100 shadow-sm relative isolate">
                    <div class="aspect-square bg-slate-50 rounded-[2rem] mb-6 overflow-hidden relative isolate">
                      <Image
                        src={prod.imagen_url}
                        alt={`Producto: ${prod.nombre}`}
                        width={400}
                        height={400}
                        class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 pointer-events-none select-none"
                        loading="lazy"
                        decoding="async"
                        fetchpriority="low"
                      />
                    </div>
                    <div class="px-2 flex flex-col flex-grow">
                      <h3 class="font-serif text-2xl text-secondary mb-2">
                        {prod.nombre}
                      </h3>
                      <p class="text-slate-800 text-sm mb-4 line-clamp-2 flex-grow">
                        {prod.descripcion}
                      </p>
                      <div class="mt-auto pt-2">
                        <p class="text-orange-950 font-black text-xs uppercase tracking-widest bg-primary/10 inline-block px-3 py-1 rounded-lg">
                          Consultar disponibilidad
                        </p>
                      </div>
                    </div>
                  </article>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>
    )
  }
</MainLayout>

<script>
  import EmblaCarousel from "embla-carousel";
  import Autoplay from "embla-carousel-autoplay";

  const initCarousel = () => {
    const carouselNode = document.getElementById("favoritos-carousel");
    if (carouselNode) {
      EmblaCarousel(carouselNode, { loop: true, align: "start" }, [
        Autoplay({ delay: 2000, stopOnInteraction: false }),
      ]);
    }
  };

  // Executed when DOM is ready
  initCarousel();

  // Support for View Transitions
  document.addEventListener("astro:page-load", initCarousel);
</script>

<style>
  @keyframes bounce-slow {
    0%,
    100% {
      transform: translateY(0) rotate(2deg);
    }
    50% {
      transform: translateY(-20px) rotate(-2deg);
    }
  }
  .animate-bounce-slow {
    animation: bounce-slow 6s infinite ease-in-out;
  }
</style>
