---
import AdminLayout from "../../layouts/AdminLayout.astro";
import { getSupabaseServer } from "../../lib/supabase";

const supabase = await getSupabaseServer(Astro.cookies);
const {
    data: { user },
} = await supabase.auth.getUser();

if (!user) return Astro.redirect("/admin/login");

// Fetch Products
const { data: productos } = await supabase
    .from("productos")
    .select("id, nombre")
    .eq("categoria", "Galletas")
    .order("nombre");

// Fetch Raw Materials
const { data: materias } = await supabase
    .from("materias_primas")
    .select("*")
    .order("nombre");

const productsList = productos || [];
const materialsList = materias || [];
---

<AdminLayout title="Gestión de Recetas">
    <div class="space-y-6">
        <!-- Header Card -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
            <div
                class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6"
            >
                <div>
                    <h1 class="text-2xl font-black text-secondary">
                        Nueva Fórmula Maestra
                    </h1>
                    <p class="text-slate-500 text-sm">
                        Define los ingredientes standard para tus productos.
                    </p>
                </div>
                <button
                    id="saveBtn"
                    class="bg-primary text-white px-8 py-3 rounded-xl font-bold hover:bg-secondary transition-colors shadow-lg shadow-primary/20 flex items-center gap-2"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-5 w-5"
                        viewBox="0 0 20 20"
                        fill="currentColor"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                            clip-rule="evenodd"></path>
                    </svg>
                    Guardar Fórmula
                </button>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div>
                    <label
                        class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2"
                        >Producto</label
                    >
                    <div class="relative">
                        <select
                            id="productoSelect"
                            class="w-full bg-gray-50 border-transparent focus:border-primary focus:bg-white focus:ring-0 rounded-xl h-12 px-4 font-bold text-secondary cursor-pointer disabled:opacity-50"
                            disabled={productsList.length === 0}
                        >
                            <option value="">
                                {
                                    productsList.length === 0
                                        ? "No hay galletas disponibles"
                                        : "Selecciona un producto..."
                                }
                            </option>
                            {
                                productsList.map((p) => (
                                    <option value={p.id}>{p.nombre}</option>
                                ))
                            }
                        </select>
                        {
                            productsList.length === 0 && (
                                <p class="text-xs text-orange-500 mt-2 font-bold">
                                    No se encontraron galletas para asignar
                                    fórmulas.
                                </p>
                            )
                        }
                    </div>
                </div>
                <div>
                    <label
                        class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2"
                        >Nombre de la Receta</label
                    >
                    <input
                        type="text"
                        id="nombreReceta"
                        placeholder="Ej. Receta Base 2024"
                        class="w-full bg-gray-50 border-transparent focus:border-primary focus:bg-white focus:ring-0 rounded-xl h-12 px-4 font-bold text-secondary"
                    />
                </div>
                <div>
                    <label
                        class="block text-xs font-bold text-slate-400 uppercase tracking-widest mb-2"
                        >Cantidad Base (Rendimiento)</label
                    >
                    <div class="relative">
                        <input
                            type="number"
                            id="cantidadBase"
                            placeholder="100"
                            class="w-full bg-gray-50 border-transparent focus:border-primary focus:bg-white focus:ring-0 rounded-xl h-12 px-4 font-bold text-secondary"
                        />
                        <span
                            class="absolute right-4 top-1/2 -translate-y-1/2 text-xs font-bold text-slate-400"
                            >unids</span
                        >
                    </div>
                </div>
            </div>
        </div>

        <!-- Ingredients Card -->
        <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
            <div class="flex justify-between items-center mb-6">
                <h2
                    class="text-lg font-bold text-secondary flex items-center gap-2"
                >
                    <span class="bg-blue-100 text-blue-600 p-2 rounded-lg">
                        <svg
                            xmlns="http://www.w3.org/2000/svg"
                            class="h-5 w-5"
                            fill="none"
                            viewBox="0 0 24 24"
                            stroke="currentColor"
                        >
                            <path
                                stroke-linecap="round"
                                stroke-linejoin="round"
                                stroke-width="2"
                                d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"
                            ></path>
                        </svg>
                    </span>
                    Ingredientes y Cantidades
                </h2>
                <button
                    id="addIngredientBtn"
                    class="text-primary font-bold text-sm bg-primary/10 px-4 py-2 rounded-lg hover:bg-primary hover:text-white transition-colors flex items-center gap-2"
                >
                    <svg
                        xmlns="http://www.w3.org/2000/svg"
                        class="h-4 w-4"
                        fill="none"
                        viewBox="0 0 24 24"
                        stroke="currentColor"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M12 4v16m8-8H4"></path>
                    </svg>
                    Agregar Ingrediente
                </button>
            </div>

            <div class="overflow-hidden rounded-xl border border-gray-100">
                <table class="w-full text-left">
                    <thead
                        class="bg-gray-50/50 text-xs uppercase text-slate-400 font-bold tracking-wider"
                    >
                        <tr>
                            <th class="px-6 py-4">Materia Prima</th>
                            <th class="px-6 py-4 w-48">Cantidad</th>
                            <th class="px-6 py-4 w-32">Unidad</th>
                            <th class="px-6 py-4 w-16"></th>
                        </tr>
                    </thead>
                    <tbody
                        id="ingredientsList"
                        class="divide-y divide-gray-100"
                    >
                        <!-- Dynamic Rows will appear here -->
                        <tr id="emptyState">
                            <td
                                colspan="4"
                                class="px-6 py-8 text-center text-slate-400 text-sm"
                            >
                                No hay ingredientes agregados aún.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</AdminLayout>

<script define:vars={{ materialsList }}>
    // DOM Elements
    const addBtn = document.getElementById("addIngredientBtn");
    const ingredientsList = document.getElementById("ingredientsList");
    const emptyState = document.getElementById("emptyState");
    const saveBtn = document.getElementById("saveBtn");

    // Logic
    let ingredients = [];

    function renderRows() {
        // Clear current rows except empty state (which we toggle)
        // Actually simpler to just rebuild innerHTML
        if (ingredients.length === 0) {
            ingredientsList.innerHTML = `<tr id="emptyState"><td colspan="4" class="px-6 py-8 text-center text-slate-400 text-sm">No hay ingredientes agregados aún.</td></tr>`;
            return;
        }

        ingredientsList.innerHTML = "";

        ingredients.forEach((ing, index) => {
            const tr = document.createElement("tr");
            tr.className = "group hover:bg-gray-50/50 transition-colors";
            tr.innerHTML = `
        <td class="px-6 py-3">
          <select 
            data-index="${index}"
            class="ingredient-select w-full bg-white border border-gray-200 focus:border-primary focus:ring-0 rounded-lg h-10 px-3 text-sm font-medium text-slate-700"
          >
            <option value="">Selecciona ingrediente...</option>
            ${materialsList.map((m) => `<option value="${m.id}" ${m.id === ing.materia_prima_id ? "selected" : ""} data-unit="${m.unidad}">${m.nombre}</option>`).join("")}
          </select>
        </td>
        <td class="px-6 py-3">
          <input 
            type="number" 
            step="0.01" 
            value="${ing.cantidad_necesaria}" 
            data-index="${index}"
            class="ingredient-qty w-full bg-white border border-gray-200 focus:border-primary focus:ring-0 rounded-lg h-10 px-3 text-sm font-bold text-slate-700"
            placeholder="0.00"
          />
        </td>
        <td class="px-6 py-3">
          <span class="text-sm font-bold text-slate-500 bg-gray-100 px-3 py-1 rounded-md block text-center">
            ${ing.unidad_medida || "-"}
          </span>
        </td>
        <td class="px-6 py-3 text-right">
          <button 
            onclick="removeIngredient(${index})"
            class="text-slate-300 hover:text-red-500 p-2 rounded-full hover:bg-red-50 transition-all"
          >
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        </td>
      `;
            ingredientsList.appendChild(tr);
        });

        // Re-attach listeners
        document.querySelectorAll(".ingredient-select").forEach((select) => {
            select.addEventListener("change", (e) => {
                const idx = e.target.dataset.index;
                const val = e.target.value;
                const option = e.target.options[e.target.selectedIndex];

                ingredients[idx].materia_prima_id = val;
                ingredients[idx].unidad_medida = option.dataset.unit || "";
                renderRows();
            });
        });

        document.querySelectorAll(".ingredient-qty").forEach((input) => {
            input.addEventListener("input", (e) => {
                const idx = e.target.dataset.index;
                ingredients[idx].cantidad_necesaria = e.target.value;
            });
        });
    }

    // Add Row
    addBtn.addEventListener("click", () => {
        ingredients.push({
            materia_prima_id: "",
            cantidad_necesaria: "",
            unidad_medida: "",
        });
        renderRows();
    });

    // Remove Row (Global capability)
    window.removeIngredient = (index) => {
        ingredients.splice(index, 1);
        renderRows();
    };

    // Save Logic
    saveBtn.addEventListener("click", async () => {
        const productoId = document.getElementById("productoSelect").value;
        const nombreReceta = document.getElementById("nombreReceta").value;
        const cantidadBase = document.getElementById("cantidadBase").value;

        if (!productoId || !nombreReceta || !cantidadBase) {
            alert(
                "Por favor completa los datos de la cabecera (Producto, Nombre, Cantidad Base).",
            );
            return;
        }

        if (ingredients.length === 0) {
            alert("Debes agregar al menos un ingrediente.");
            return;
        }

        // Validate details
        const isValid = ingredients.every(
            (i) => i.materia_prima_id && i.cantidad_necesaria > 0,
        );
        if (!isValid) {
            alert(
                "Revisa que todos los ingredientes tengan producto seleccionado y cantidad válida.",
            );
            return;
        }

        // Prepare Payload
        const payload = {
            producto_id: productoId,
            nombre_receta: nombreReceta,
            cantidad_base: cantidadBase,
            ingredientes: ingredients,
        };

        // Send
        saveBtn.innerText = "Guardando...";
        saveBtn.disabled = true;

        try {
            const res = await fetch("/api/recipes", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
            });

            const result = await res.json();

            if (res.ok) {
                alert("¡Fórmula guardada con éxito!");
                window.location.reload(); // Reset form
            } else {
                alert("Error: " + result.message);
            }
        } catch (e) {
            console.error(e);
            alert("Error de conexión.");
        } finally {
            saveBtn.innerText = "Guardar Fórmula";
            saveBtn.disabled = false;
        }
    });
</script>
